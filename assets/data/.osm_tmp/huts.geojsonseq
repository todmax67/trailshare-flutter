{"type":"Feature","id":"w83223934","geometry":{"type":"LineString","coordinates":[[9.3524574,45.9747249],[9.3524938,45.9747922],[9.3525817,45.9747693],[9.3525538,45.9747178],[9.3525453,45.974702],[9.3524574,45.9747249]]},"properties":{"@version":8,"@timestamp":1740687000,"access":"yes","building":"yes","contact:phone":"+39 0341 860111","description":"Il bivacco è sempre aperto: contiene camino, stufa, legna, tavolone di legno e relative panche, nessun posto letto. All'esterno una scala e una porta chiusa a chiave conducono ad un locale nel sottotetto. Telefono gestore: 0341 860111.","drinking_water":"no","ele":"1740","heating":"fireplace","mattress":"no","name":"Bivacco Baitello dell'amicizia","opening_hours":"24/7","operator":"Comune di Esino Lario","shower":"no","source":"PCN ortofoto a colori 2006, survey","toilets":"no","tourism":"wilderness_hut","wikidata":"Q131929627"}}
